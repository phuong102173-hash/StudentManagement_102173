# Export variables in your shell; the application does not auto-load this file.
# OpenAI-compatible endpoint: local vLLM / Ollama or a hosted provider.
# The API key is optional for a local endpoint. Never commit a real key.
JUDGE_BASE_URL=http://127.0.0.1:8001/v1
JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
# JUDGE_API_KEY=

# Explicitly enable heavyweight local models after installing .[models].
ENABLE_LOCAL_MODELS=0
NLI_MODEL=cross-encoder/nli-deberta-v3-small
# NLI_REVISION=<optional immutable model commit>
# HHEM v1 runs as a CrossEncoder without executing remote Python code.
HHEM_MODEL=vectara/hallucination_evaluation_model
HHEM_REVISION=hhem-1.0-open
MODEL_DEVICE=cpu
